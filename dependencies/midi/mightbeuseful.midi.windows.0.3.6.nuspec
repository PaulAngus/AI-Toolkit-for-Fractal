<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>MightBeUseful.Midi.Windows</id>
    <version>0.3.6</version>
    <authors>Paul Angus</authors>
    <readme>README.md</readme>
    <description>Shared MIDI transport and platform implementations for MightBeUseful applications.</description>
    <repository type="git" url="https://github.com/PaulAngus/MIDIHelperLibrary" commit="61c6e9ad0429f2a9087e84a562bdea92ca896ff3" />
    <dependencies>
      <group targetFramework="net10.0-windows10.0.19041">
        <dependency id="MightBeUseful.Midi" version="0.3.6" exclude="Build,Analyzers" />
        <dependency id="NAudio.Midi" version="3.0.1" exclude="Build,Analyzers" />
        <dependency id="NAudio.WinMM" version="3.0.1" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>