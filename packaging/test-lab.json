{
  "applicationId": "fractal-ai-toolkit",
  "applicationName": "AI Toolkit for Fractal",
  "runner": {
    "project": "tools/Fractal.Lab/Fractal.Lab.csproj",
    "destination": "bin/lab",
    "executable": "bin/lab/Fractal.Lab"
  },
  "platforms": {
    "win": {
      "tests": [
        {
          "project": "tests/Fractal.Checks/Fractal.Checks.csproj",
          "destination": "bin/tests"
        }
      ]
    },
    "osx": {
      "tests": [
        {
          "project": "tests/Fractal.Checks/Fractal.Checks.csproj",
          "destination": "bin/tests"
        }
      ],
      "properties": [
        "-p:FractalPortableBuild=true"
      ]
    }
  },
  "agentVersion": "0.2.5"
}
